{
  "name": "estore",
  "version": "0.0.0",
  "description": "My EStore Angular project",
  "author": "Watojo Fokamel <fokamel@lwatojoel.dev>",
  "homepage": "https://watojoel.dev",
  "license": "MIT",
  "contributors": [
    "Watojo Fokamel <fokamel@lwatojoel.dev>"
  ],
  "keywords": [
    "angular",
    "angular 19",
    "primeng",
    "angular template",
    "jest",
    "transloco",
    "prettier",
    "cypress",
    "compodoc",
    "eslint",
    "storybook",
    "tailwind"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "check-format": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "audit": "auditjs ossi",
    "commitlint": "commitlint --edit",
    "commit-msg": "npm run commitlint -- $GIT_PARAMS",
    "lint": "eslint src/app/**/*.ts",
    "test": "jest",
    "prepare": "husky install",
    "pre-commit": "npm run lint && npm run test",
    "storybook": "ng run estore:storybook",
    "build-storybook": "ng run estore:build-storybook",
    "cy:open": "cypress open",
    "chromatic": "npx chromatic --project-token=chpt_105d2d5ee801261"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.1",
    "@angular/common": "^19.2.1",
    "@angular/compiler": "^19.2.1",
    "@angular/core": "^19.2.1",
    "@angular/forms": "^19.2.1",
    "@angular/platform-browser": "^19.2.1",
    "@angular/platform-browser-dynamic": "^19.2.1",
    "@angular/router": "^19.2.1",
    "@flaticon/flaticon-uicons": "^3.3.1",
    "@jsverse/transloco": "^7.5.1",
    "@primeng/themes": "^19.0.9",
    "gsap": "^3.12.7",
    "primelocale": "^2.0.3",
    "primeng": "^19.0.9",
    "quill": "^2.0.3",
    "rxjs": "~7.8.0",
    "simplebar-angular": "^3.3.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.1",
    "@angular-devkit/schematics-cli": "^19.2.3",
    "@angular/cli": "^19.2.1",
    "@angular/compiler-cli": "^19.2.1",
    "@chromatic-com/storybook": "^3.2.5",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@compodoc/compodoc": "^1.1.26",
    "@storybook/addon-docs": "^8.6.4",
    "@storybook/addon-essentials": "^8.6.4",
    "@storybook/addon-interactions": "^8.6.4",
    "@storybook/addon-onboarding": "^8.6.4",
    "@storybook/angular": "^8.6.4",
    "@storybook/blocks": "^8.6.4",
    "@storybook/test": "^8.6.4",
    "@tailwindcss/forms": "^0.5.10",
    "@types/jasmine": "~5.1.0",
    "@types/jest": "^29.5.14",
    "@types/json-server": "^0.14.7",
    "angular-eslint": "19.2.1",
    "auditjs": "^4.0.46",
    "auto-changelog": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "chromatic": "^11.27.0",
    "cypress": "^14.2.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-storybook": "^0.11.4",
    "husky": "^9.1.7",
    "jasmine-core": "~5.5.0",
    "jest": "^29.7.0",
    "jest-preset-angular": "^14.5.3",
    "json-server": "^0.17.4",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "msw": "^2.7.3",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "storybook": "^8.6.4",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "8.26.0"
  },
  "lint-staged": {
    "*.{js,json,css,scss,less,md,ts,html,component.html,page.html}": [
      "prettier --write"
    ]
  }
}
